#!/bin/sh
# /usr/sbin/ota-check — check for and apply an OpenLinxdot OTA update.
#
# Flow: fetch manifest.json from GitHub Releases → compare versions → download
# the .swu → hand to SWUpdate, which writes to the INACTIVE slot and sets
# upgrade_available=1 / boot_slot=<target> in the U-Boot env → reboot.
# On reboot, U-Boot trial-boots the new slot; S98confirm commits if healthy,
# U-Boot rolls back if it exceeds bootlimit attempts.
#
# Refuses to run while the current slot is still in trial mode (unless
# --dry-run is passed — that mode is the trial-boot health probe and so
# must run with upgrade_available=1).
#
# Modes:
#   (none)     full flow — fetch manifest, download .swu, apply, reboot.
#   --dry-run  prove the OTA path is alive: clock-step + manifest fetch
#              + parse. Does NOT download the .swu, does NOT touch
#              U-Boot env. Used by S98confirm as the trial-boot gate.

set -e

DRY_RUN=0
case "${1:-}" in
    --dry-run) DRY_RUN=1 ;;
    "") ;;
    *) echo "usage: $0 [--dry-run]" >&2; exit 2 ;;
esac

# Config, same sources S60ota and health-probe use. Plain if-blocks, not
# `[ -r f ] && . f`: under `set -e` that exits 1 when the file is absent.
if [ -r /etc/default/ota ]; then . /etc/default/ota; fi
if [ -r /data/ota.conf ];   then . /data/ota.conf;   fi

MANIFEST_URL="${OTA_MANIFEST_URL:-https://github.com/SensorsIot/Linxdot-Hotspot/releases/latest/download/manifest.json}"
PUBKEY="${OTA_PUBKEY:-/etc/swupdate/public.pem}"

log() { logger -t ota "$*"; echo "ota: $*"; }
die() { log "error: $*"; exit 1; }

# version_newer A B -- true when dotted-numeric A is strictly newer than B.
# String equality alone is not enough: it treats a republished or pulled
# release as an update and walks the device backwards (1.0.10 also sorts
# below 1.0.9 lexically). Compares field by field, missing fields read as 0,
# so 2.1 and 2.1.0 tie. A non-numeric suffix compares by its leading number,
# so 2.0.0-rc1 ties with 2.0.0 -- deliberately the no-update outcome, which
# is the safe one.
version_newer() {
    _i=1
    while [ "$_i" -le 4 ]; do
        _x=$(printf '%s' "$1" | cut -d. -f"$_i" | sed 's/[^0-9].*//')
        _y=$(printf '%s' "$2" | cut -d. -f"$_i" | sed 's/[^0-9].*//')
        [ -n "$_x" ] || _x=0
        [ -n "$_y" ] || _y=0
        [ "$_x" -gt "$_y" ] && return 0
        [ "$_x" -lt "$_y" ] && return 1
        _i=$((_i + 1))
    done
    return 1
}

if [ "$DRY_RUN" -eq 0 ]; then
    UPGRADE_AVAILABLE=$(fw_printenv -n upgrade_available 2>/dev/null || echo "0")
    if [ "$UPGRADE_AVAILABLE" = "1" ]; then
        die "current slot not committed (upgrade_available=1) — wait for S98confirm"
    fi
fi

# Step the wall-clock if stale before any HTTPS — the LD1001 has no
# battery RTC, and curl will otherwise fail "cert not yet valid".
# Idempotent and a fast no-op if the clock is already sane.
/usr/sbin/clock-bootstrap || log "warning: clock-bootstrap failed; HTTPS may fail cert validation"

CURRENT_SLOT=$(fw_printenv -n boot_slot 2>/dev/null || echo "A")
if [ "$CURRENT_SLOT" = "A" ]; then TARGET_SLOT=B; else TARGET_SLOT=A; fi

MANIFEST=/tmp/ota-manifest.json
log "fetching $MANIFEST_URL"
curl -fsS --max-time 30 -L "$MANIFEST_URL" -o "$MANIFEST" \
    || die "could not fetch manifest"

REMOTE_VERSION=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$MANIFEST")
REMOTE_URL=$(    sed -n 's/.*"url"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p'     "$MANIFEST")
REMOTE_SHA=$(    sed -n 's/.*"sha256"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p'  "$MANIFEST")

[ -n "$REMOTE_VERSION" ] || die "manifest missing version"
[ -n "$REMOTE_URL" ]     || die "manifest missing url"

CURRENT_VERSION=$(. /etc/os-release 2>/dev/null; echo "${VERSION_ID:-unknown}")
log "current=$CURRENT_VERSION remote=$REMOTE_VERSION active=$CURRENT_SLOT target=$TARGET_SLOT"

# Dry-run gate: getting this far means clock + DNS + TLS trust + manifest
# fetch + parse all worked. That's the entire chain S98confirm needs to
# verify the trial-booted slot can still receive the next update.
if [ "$DRY_RUN" -eq 1 ]; then
    log "dry-run OK — manifest reachable and parseable"
    exit 0
fi

if [ "$REMOTE_VERSION" = "$CURRENT_VERSION" ]; then
    log "already up to date"
    exit 0
fi

# Refuse to walk backwards. Deleting or replacing a published release makes
# an older manifest "latest"; with a bare inequality test every device would
# then install it as though it were an update.
if ! version_newer "$REMOTE_VERSION" "$CURRENT_VERSION"; then
    if [ "${OTA_ALLOW_DOWNGRADE:-0}" = "1" ]; then
        log "remote $REMOTE_VERSION older than current $CURRENT_VERSION — installing anyway (OTA_ALLOW_DOWNGRADE=1)"
    else
        log "remote $REMOTE_VERSION older than current $CURRENT_VERSION — refusing to downgrade (set OTA_ALLOW_DOWNGRADE=1 in /data/ota.conf to override)"
        exit 0
    fi
fi

SWU=/tmp/update.swu
rm -f "$SWU"

# Pre-flight: ensure /tmp has enough room for the .swu. Catches the case
# where /tmp is unexpectedly backed by a small filesystem (see S01mountall
# /var/log-overlay bug) before we burn network bandwidth on a doomed curl.
REMOTE_SIZE=$(sed -n 's/.*"size"[[:space:]]*:[[:space:]]*\([0-9]*\).*/\1/p' "$MANIFEST")
TMP_FREE_KB=$(df -P /tmp | awk 'NR==2 {print $4}')
TMP_FREE=$(( TMP_FREE_KB * 1024 ))
if [ -n "$REMOTE_SIZE" ] && [ "$TMP_FREE" -lt "$REMOTE_SIZE" ]; then
    die "insufficient free space in /tmp ($TMP_FREE B) for .swu ($REMOTE_SIZE B)"
fi

log "downloading $REMOTE_URL"
curl -fsS --max-time 600 -L "$REMOTE_URL" -o "$SWU" \
    || { rm -f "$SWU"; die "download failed"; }

if [ -n "$REMOTE_SHA" ]; then
    GOT=$(sha256sum "$SWU" | cut -d' ' -f1)
    [ "$GOT" = "$REMOTE_SHA" ] || die "sha256 mismatch (manifest=$REMOTE_SHA got=$GOT)"
fi

log "applying to slot $TARGET_SLOT"
# Selector format: <software_set>,<running_mode>. SWUpdate splits only at the
# first comma — "stable,linxdot-ld1001,target-B" would set running_mode to
# the literal "linxdot-ld1001,target-B" which libconfig can't path-lookup.
SWUPDATE_ARGS="-v -i $SWU -e stable,target-${TARGET_SLOT}"
if [ -f "$PUBKEY" ]; then
    SWUPDATE_ARGS="$SWUPDATE_ARGS -k $PUBKEY"
else
    log "WARNING: no public key at $PUBKEY — signature verification disabled"
fi

# shellcheck disable=SC2086
swupdate $SWUPDATE_ARGS || { rm -f "$SWU"; die "swupdate rejected bundle"; }

rm -f "$SWU"
log "update staged, rebooting into slot $TARGET_SLOT"
sync
sleep 2
reboot
